# Supabase — Project Settings > API
# IMPORTANTE: este proyecto es COMPARTIDO con otro producto de
# ColombiaTech (schema `public`). Todas las tablas de SponsorHub viven
# en el schema `sponsorhub` — ver supabase/migrations/0001_init.sql.
# Antes de que esto funcione, hay que agregar `sponsorhub` en
# Settings > API > Exposed schemas del dashboard de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Notion — https://www.notion.so/my-integrations
# La integración debe tener acceso a la database de sponsors de GovTech.
NOTION_API_KEY=

# UUID de la data source / database de sponsors GovTech (sin collection://).
# Si eventos.notion_source_id de govtech-2026 está vacío, el sync lo usa
# como fallback y lo persiste. CTW/CTF no se sincroniza.
NOTION_GOVTECH_DATA_SOURCE_ID=

# UUID de LAB Beneficios GovTech (collection / database, sin collection://).
# Fuente de verdad de compromisos para govtech-2026. La integración
# "Sponsors Sync" debe tener Connection a esta database.
NOTION_LAB_BENEFICIOS_ID=3d499829d2178030843b000b03549d2b

# Secreto para autenticar el cron de Vercel contra /api/sync/notion
# Generar con: openssl rand -hex 32
CRON_SECRET=

# Reserva para cuando Notion firme webhooks. Hoy /api/webhook/notion
# no valida firma (Notion aún no la envía en esta integración).
NOTION_WEBHOOK_SECRET=

# Sembrar el evento (SQL Editor), una vez tengas el UUID:
#   UPDATE sponsorhub.eventos
#   SET estado = 'activo',
#       notion_source_id = '<NOTION_GOVTECH_DATA_SOURCE_ID>'
#   WHERE slug = 'govtech-2026';
# Dejar notion_source_id NULL en cualquier otro evento.

# Cron: vercel.json corre /api/sync/notion una vez al día a las 8:00 UTC
# (0 8 * * *). El webhook /api/webhook/notion maneja cambios en tiempo
# casi real; el cron es solo fallback diario.
