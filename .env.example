# Supabase — Project Settings > API
# IMPORTANTE: este proyecto es COMPARTIDO con otro producto de
# ColombiaTech (schema `public`). Todas las tablas de SponsorHub viven
# en el schema `sponsorhub` — ver supabase/migrations/0001_init.sql.
# Antes de que esto funcione, hay que agregar `sponsorhub` en
# Settings > API > Exposed schemas del dashboard de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Notion — https://www.notion.so/my-integrations
NOTION_API_KEY=

# Secreto para autenticar el cron de Vercel contra /api/sync/notion
# Generar con: openssl rand -hex 32
CRON_SECRET=

# NOTA: Vercel Cron en plan Hobby permite mínimo 1 invocación/día, NO
# cada 5 min. El sync periódico de 1-5 min (decisión de este proyecto)
# requiere Vercel Pro. Si se queda en Hobby, ajustar vercel.json a un
# cron diario y evaluar si el caso de uso lo tolera, o usar un cron
# externo (ej. GitHub Actions, cron-job.org) que llame al endpoint.
